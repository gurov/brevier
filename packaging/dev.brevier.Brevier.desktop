[Desktop Entry]
Type=Application
Name=Brevier
GenericName=Reader
Comment=Read the web without JavaScript, in typography you choose
Exec=brevier-ui %u
Icon=dev.brevier.Brevier
Terminal=false
StartupNotify=true
StartupWMClass=dev.brevier.Brevier
Categories=Network;WebBrowser;
MimeType=x-scheme-handler/http;x-scheme-handler/https;text/markdown;text/x-markdown;
Keywords=web;browser;reader;markdown;article;
