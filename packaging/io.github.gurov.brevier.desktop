[Desktop Entry]
Type=Application
Name=Brevier
GenericName=Web Reader
Comment=Read the web without JavaScript, in typography you choose
Exec=brevier-ui %u
Icon=io.github.gurov.brevier
Terminal=false
StartupNotify=true
StartupWMClass=brevier-ui
Categories=Network;WebBrowser;
MimeType=x-scheme-handler/http;x-scheme-handler/https;text/markdown;text/x-markdown;
Keywords=web;browser;reader;markdown;article;
