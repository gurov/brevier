# Ядро ищет нативные методы по именам класса и методов
# (`Java_io_github_gurov_brevier_Core_*` в src/android.rs): ни переименовать,
# ни слить `Core` с другим классом R8 не вправе.
-keep class io.github.gurov.brevier.Core {
    native <methods>;
}

# Имена не шифруем: код открытый, а стек падения из отчёта читателя должен
# читаться без файла соответствий. Неиспользуемое R8 выбрасывает всё равно.
-dontobfuscate
